# No java: — the test VM is the same as the build's. A fixed path would
# only be valid on one machine; the minimum version a run requires is
# recorded as jdk.run.minimum in the POM.
-tester: biz.aQute.junit

-runee: JavaSE-11

-resolve.effective: active

-runvm: ${def;argLine}, -Djava.security.manager=allow, -Djava.security.policy=all.policy

-runproperties: \
	org.osgi.framework.security=osgi,\
	org.osgi.framework.trust.repositories=${def;tck.keystore}

-runfw: org.eclipse.osgi


# API overlays on the framework classpath (exports become system packages)
-runpath: \
	org.apache.servicemix.bundles.junit;version='${tck.range;${servicemix-junit.version}}',\
	assertj-core;version='${tck.range;${assertj.version}}',\
	net.bytebuddy.byte-buddy;version='${tck.range;${byte-buddy.version}}'

# This will help us keep -runbundles sorted
-runstartlevel: \
    order=sortbynameversion,\
    begin=-1

# Test runtime versions: the Maven properties of tck/pom.xml, as the OSGi
# range [x.y.z,x.y.z+1). version_cleanup turns 1.4.0-SNAPSHOT into 1.4.0.SNAPSHOT.
tck.range: ${range;[===,==+);${version_cleanup;${1}}}

-runrequires: \
	bnd.identity;id='org.osgi.test.cases.condpermadmin';version='${tck.range;${revision}}'

# Test infrastructure for the junit-platform tester — mirrors the original
# cnf/repo/osgi.tck.junit-platform lib that every TCK run carried


# -runbundles is committed and verified by the build; after a dependency
# change update it with: mvn bnd-resolver:resolve
-runbundles: org.osgi.test.cases.condpermadmin;version='${tck.range;${revision}}'
