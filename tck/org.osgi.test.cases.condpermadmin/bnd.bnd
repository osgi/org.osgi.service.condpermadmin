# Set javac settings from JDT prefs
# The test case wipes out permissions for all bundles, so we need
# to place the tester on the classpath rather than being in a bundle.

Bundle-Description: Conditional Permission Admin Test R42
Bundle-DocURL: http://www.osgi.org/
Bundle-ContactAddress: info@mail.osgi.org
Bundle-Category: osgi,test
Export-Package: ${p}.service
DynamicImport-Package: ${p}.testcond

-conditionalpackage					= org.osgi.tck.signature.*
-privatepackage						=  \
	${p}.junit, \
	${p}
Import-Package: !${p}.testcond, ${-signaturetest}, *

-includeresource					= \
	tb1.jar, \
	tb2.jar, \
	tb3.jar, \
	testcond.jar, \
	
-signaturetest                      = org.osgi.service.condpermadmin




javac.deprecation=false

p: org.osgi.test.cases.condpermadmin

# Maven build: workspace includes replaced inline (from cnf/includes and build.bnd in osgi/osgi)
# -make.maven, not -make: the key is a map entry and would displace
# a project-level -make (webcontainer also builds .war recipes this
# way). bnd merges all -make.* entries.
-make.maven: (*).(jar); type=bnd; recipe="bnd/$1.bnd"

testcases.junit5: ${classes;HIERARCHY_INDIRECTLY_ANNOTATED;org.junit.platform.commons.annotation.Testable;CONCRETE}
Test-Cases: ${sort;${uniq;${testcases.junit5}}}
-plugin.signaturetest: SignatureTest
-plugin.signer: aQute.bnd.signing.JartoolSigner;keystore="../keystore";keypass=testtest;storepass=testtest;digestalg=SHA-256
